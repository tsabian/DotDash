# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require 'dotenv'

default_platform(:ios)
Dotenv.load('.env')

platform :ios do
  desc "Runs tests"
  lane :test do
    ENV["FASTLANE_DISABLE_INTERACTIVE_PROMPTS"] = "true"
    ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "true"
    ENV["CI"] = "true"

    # 🔄 captura automaticamente o primeiro simulador disponível
    device = sh("xcrun simctl list devices available | grep -m1 'iPhone' | awk -F '(' '{print $1}'").strip
    UI.message("📱 Using simulator: #{device}")

    output_dir = "build/test_reports"

    FileUtils.mkdir_p(output_dir) 

    run_tests(
      scheme: "DotDashTests",
      configuration: "Debug",
      output_types: "junit,html",
      prelaunch_simulator: true,
      device: device,
      output_directory: output_dir,
      result_bundle: true,
      suppress_xcode_output: false,
      clean: true
    )

    UI.message("✅ Test results generated in #{output_dir}")
  end

  desc "Build without code signing for CI"
  lane :ci_build do
    clear_derived_data

    xcodebuild(
      scheme: "DotDash",
      configuration: "Debug",
      destination: "generic/platform=iOS",
      xcargs: "-allowProvisioningUpdates CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO",
      clean: true
    )
  end

  desc "Build the app for release"
  lane :build do
    build_app(
      scheme: "DotDash",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "./build",
      export_options: {
        provisioningProfiles: {
          "br.com.bitxlabs.app.dotdash.ios" => "dotdash-distribution"
        }
      }
    )
  end

  desc "Sends to TestFlight"
  lane :deploy do
    key_content  = ENV["APP_STORE_CONNECT_KEY_CONTENT"]
    key_id       = ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id    = ENV["APP_STORE_CONNECT_ISSUER_ID"]

    UI.user_error!("❌ APP_STORE_CONNECT_KEY_ID ausente")      if (key_id.nil? || key_id.strip.empty?)
    UI.user_error!("❌ APP_STORE_CONNECT_ISSUER_ID ausente")   if (issuer_id.nil? || issuer_id.strip.empty?)

    # 1️⃣ Configura a autenticação com a App Store Connect API
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: true
    )

    # 2️⃣ Faz o upload para o TestFlight
    upload_to_testflight(
      api_key: api_key,
      distribute_external: false,
      skip_waiting_for_build_processing: true,
      ipa: "./build/DotDash.ipa"
    )

    # 3️⃣ Localiza o script de upload do Firebase (para SPM)
    derived_data = File.expand_path("~/Library/Developer/Xcode/DerivedData")
    upload_symbols_script = Dir.glob("#{derived_data}/**/firebase-ios-sdk/Crashlytics/upload-symbols").first

    unless upload_symbols_script && File.exist?(upload_symbols_script)
      UI.important("⚠️ Script upload-symbols não encontrado em DerivedData. Tentando caminho alternativo (local)...")
      upload_symbols_script = Dir.glob("**/firebase-ios-sdk/Crashlytics/upload-symbols").first
    end

    unless upload_symbols_script && File.exist?(upload_symbols_script)
      UI.user_error!("❌ Não foi possível localizar o script upload-symbols (Firebase Crashlytics via SPM).")
    end

    UI.message("📦 Uploading dSYM to Firebase Crashlytics using: #{upload_symbols_script}")

    # 4️⃣ Localiza o .dSYM.zip na pasta de build
    # localize first all dSYM.zip files in build directory
    
  dsym_files = Dir.glob("build/*.dSYM.zip") +
               Dir.glob("./build/*.dSYM.zip") +
               Dir.glob("../build/*.dSYM.zip")

    if dsym_files.empty?
      UI.user_error!("❌ Nenhum arquivo dSYM.zip encontrado na pasta build/")
    end

    UI.message("📦 Uploading dSYM to Firebase Crashlytics...")

    # 5️⃣ Faz o upload de todos os dSYM encontrados
    dsym_files.each do |dsym|
      sh("#{upload_symbols_script}",
        "-gsp", "../App/Sources/SupportingFiles/GoogleService-Info.plist",
        "-p", "ios",
        dsym)
    end

    UI.success("✅ Todos os dSYMs foram enviados com sucesso ao Firebase Crashlytics!")

  end

  desc "Deploy to the App Store"
  lane :beta do
    test
    build
    deploy
  end
end
